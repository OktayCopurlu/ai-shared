{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-shared.local/experiment/delivery-pipeline/fix-request.schema.json",
  "title": "Delivery Pipeline Fix Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_phase",
    "severity",
    "acceptance_criteria",
    "scenario",
    "expected",
    "actual",
    "reproduction",
    "suggested_direction"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "source_phase": {
      "type": "string",
      "enum": [
        "context-intake",
        "plan",
        "implement",
        "test-review",
        "code-review",
        "qa",
        "ui-validation",
        "create-pr",
        "pr-code-review",
        "pr-qa",
        "pr-ui-validation"
      ]
    },
    "severity": { "type": "string", "enum": ["blocker", "high", "medium", "low"] },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenario": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "minLength": 1 },
    "actual": { "type": "string", "minLength": 1 },
    "reproduction": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_direction": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
