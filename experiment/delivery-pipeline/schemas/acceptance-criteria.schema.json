{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-shared.local/experiment/delivery-pipeline/acceptance-criteria.schema.json",
  "title": "Delivery Pipeline Acceptance Criteria Artifact",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "text"],
    "properties": {
      "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
      "text": { "type": "string", "minLength": 1 },
      "source": { "type": ["string", "null"] },
      "priority": { "type": ["string", "null"] },
      "observable_behavior": { "type": ["string", "null"] }
    }
  }
}
