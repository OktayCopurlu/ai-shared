{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-shared.local/experiment/delivery-pipeline/figma-specs.schema.json",
  "title": "Delivery Pipeline Figma Specs Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["available"],
  "allOf": [
    {
      "if": { "properties": { "available": { "const": false } }, "required": ["available"] },
      "then": { "required": ["reason"] }
    },
    {
      "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
      "then": {
        "required": ["source"],
        "anyOf": [
          { "required": ["screens"], "properties": { "screens": { "minItems": 1 } } },
          { "required": ["components"], "properties": { "components": { "minItems": 1 } } }
        ]
      }
    }
  ],
  "properties": {
    "available": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "node": { "type": "string", "minLength": 1 },
    "screens": {
      "type": "array",
      "items": { "$ref": "#/$defs/screen_spec" }
    },
    "frame_exports": {
      "type": "array",
      "items": { "$ref": "#/$defs/frame_export" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component_spec" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "screen_spec": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "bounds": { "type": "object" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "layout": { "type": ["object", "string"] },
        "spacing": { "type": ["object", "string", "array"] },
        "typography": { "type": ["object", "array"] },
        "colors": { "type": ["object", "array"] },
        "states": { "type": ["object", "array"] },
        "interactions": { "type": ["object", "array"] },
        "responsive_behavior": { "type": ["object", "string", "array"] }
      }
    },
    "frame_export": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "component_spec": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "states": { "type": ["object", "array"] },
        "layout": { "type": ["object", "string"] },
        "tokens": { "type": ["object", "array"] }
      }
    }
  }
}
