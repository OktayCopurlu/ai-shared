# Copy this file to .secrets and fill in your values.
# .secrets is gitignored and never pushed to GitHub.
# Skills reference this file by path — do not rename it.

## On Staging / Preview HTTP Basic Auth
STAGING_USER=
STAGING_PASS=

## Cloudflare Access (Zero Trust) service token for *.stg.int.on.com previews
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
